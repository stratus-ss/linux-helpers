# ebook2audiobook on torch.xpu -- built from scratch on an Arch base.
#
# WHY ARCH, and not upstream's Debian bookworm image:
#
# No Debian/Ubuntu packaging of Intel's Level Zero driver supports Battlemage.
# Measured on 2026-11-17 against this card (8086:E223, xe driver):
#
#   Debian 12 bookworm  intel-opencl-icd      22.43.24595.41   (no L0 driver at all)
#   Intel apt repo      libze-intel-gpu1      25.18.33578.15   (0 Battlemage strings)
#   Arch rolling        intel-compute-runtime 26.40.40196.8    (names "Arc(TM) Pro B70")
#
# The Intel repo tops out at 25.18 for BOTH jammy and noble, and newer packages
# need glibc >= 2.38 -- bookworm has 2.36. Inside the Debian image the result
# was `zeInit` -> ZE_RESULT_ERROR_UNINITIALIZED and torch reporting "XPU device
# count is zero", with a correct +xpu torch. The driver was present; it simply
# did not know the card. Arch ships the runtime the working host runs.
FROM archlinux:base

# Build args are declared after FROM to be in scope for the image: without
# this, DOCKER_DEVICE_STR expands to empty, the app falls back to its CUDA
# default, and the image ships CPU fallback -- upstream issue #2055.
ARG DEVICE_TAG=xpu
ARG DOCKER_DEVICE_STR={"name": "xpu", "os": "manylinux_2_28", "arch": "x86_64", "pyvenv": [3, 12], "tag": "xpu"}
ENV DEVICE_TAG=${DEVICE_TAG}
ENV DOCKER_DEVICE_STR=${DOCKER_DEVICE_STR}

# intel-compute-runtime is the L0 driver (libze_intel_gpu) and
# level-zero-loader is the loader it plugs into. Together they are the whole
# GPU userspace; nothing from Intel's apt repositories is used.
#
# The remaining packages mirror upstream's DOCKER_PROGRAMS_STR: the app shells
# out to ffmpeg, espeak-ng, sox, tesseract, mediainfo, node and calibre. Calibre
# is what actually converts an ebook, so leaving it out would ship a UI that
# cannot do the one thing it exists for.
#
# `pacman -Syu` is not optional: the archlinux:base image is a snapshot, and
# installing without a full upgrade either fails on signature/dependency drift
# or, worse, resolves an old compute-runtime -- the exact thing this image
# exists to avoid.
RUN pacman -Syu --needed --noconfirm \
      python python-pip uv git ffmpeg espeak-ng sox unzip curl ca-certificates \
      tesseract mediainfo nodejs npm calibre \
      intel-compute-runtime level-zero-loader \
 && pacman -Scc --noconfirm

# IN_DOCKER=1 is what app.py's is_running_in_container() reads, and
# --script_mode full_docker is refused without it ("full_docker is only an
# internal option for the docker itself"). Upstream's Dockerfile sets it; a
# from-scratch recipe has to remember it.
ENV IN_DOCKER=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

# Upstream supports up to 3.12 (MAX_PYTHON_VERSION in ebook2audiobook.command)
# and every dependency in requirements.txt has a 3.12 wheel. Arch's system
# python is 3.14, so the venv pins 3.12 with a uv standalone build rather than
# inheriting the system interpreter.
ENV UV_PYTHON_INSTALL_DIR=/opt/python
# --seed is required, not cosmetic: `uv venv` does not install pip, so bare
# `pip` falls through to Arch's system Python, which is PEP 668
# externally-managed and refuses to install anything.
RUN uv venv --python 3.12 --seed /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

WORKDIR /app

# The whole source is copied before installing: requirements.txt contains a
# local path requirement (./ext/py/demucs), so it cannot be resolved against a
# context holding only the requirements file. The source changes only when the
# pinned commit changes, so cache invalidation is not a concern.
COPY . /app

# The XPU wheels go in FIRST, not last. requirements.txt pulls torch
# transitively (torchvggish, coqui-tts, pyannote-audio) and on Linux a plain
# resolve takes PyPI's CUDA build: ~5 GB of nvidia-*/cuda-toolkit wheels,
# downloaded and then thrown away. That is also what filled the disk on an
# earlier attempt -- the build died at "no space left on device" while
# exporting. Installing the XPU wheels first means the requirement is already
# satisfied and the CUDA stack is never fetched at all.
#
# Dependencies are NOT skipped here. torch 2.15.0+xpu links libsycl.so.9, which
# arrives as one of its own dependencies (intel-sycl-rt 2026.2). An earlier
# --no-deps attempt installed the wheel without the runtime it links against
# and `import torch` died with "libsycl.so.9: cannot open shared object file".
RUN pip install --no-cache-dir \
      --index-url {{ arc_b70_e2a_index_url }} torch torchaudio

RUN pip install --no-cache-dir -r /app/requirements.txt

# ---------------------------------------------------------------------------
# THE PIN SET. This is not a preference; the dependency tree has two
# mutually exclusive branches and the requirements resolve picks the wrong one
# for a non-CUDA build.
#
# Upstream's own device_installer.py documents the split:
#
#   torch >= 2.9 -> torchcodec exists -> pyannote 4 -> hub 1.x -> transformers 5
#   torch <  2.9 -> no torchcodec     -> pyannote 3.4.0 -> hub <1.0 -> transformers 4.57.6
#
# With torch 2.15 the resolve lands on the top branch: transformers 5.x, which
# REMOVED isin_mps_friendly from transformers.pytorch_utils. coqui-tts 0.27.5
# imports that symbol (TTS/tts/layers/tortoise/autoregressive.py), so the XTTS
# engine dies at load:
#
#   ImportError: cannot import name 'isin_mps_friendly' from 'transformers.pytorch_utils'
#
# The UI still starts and the ebook is still parsed, so the failure presents as
# "it processed for a little while then stopped" rather than as a crash.
#
# torch 2.8.0+xpu is the newest XPU wheel below the 2.9 boundary, and it takes
# the bottom branch, which is intact:
#
#   transformers 4.57.6   -> still exports isin_mps_friendly
#   huggingface-hub 0.36.2 -> the <1.0 cap pyannote 3.4.0 needs
#   pyannote-audio 3.4.0   -> the last release before torchcodec
#   torchcodec             -> not installed, and not needed below torch 2.9
#
# pyannote-audio 3.4.0 pulls torch 2.15 from PyPI (the CUDA build) on the way
# in, so the XPU torch has to be reinstalled AFTER it. Order matters here:
# install the pins, then reinstall the XPU torch over the top.
RUN pip install --no-cache-dir \
      "transformers==4.57.6" \
      "huggingface-hub>=0.36.2,<1.0" \
      "pyannote-audio==3.4.0" \
 && pip install --no-cache-dir --index-url {{ arc_b70_e2a_index_url }} \
      "torch==2.8.0+xpu" "torchaudio==2.8.0+xpu" "pytorch-triton-xpu==3.4.0"

# Then prove nothing later in the resolve replaced them, and drop anything a
# dependency still managed to drag in. The assertion is what makes a silently
# CPU-only image impossible: it fails the build instead.
#
# pyannote-audio 3.4.0 brings the whole CUDA stack with it (nvidia-cublas,
# cuda-toolkit, nvidia-cudnn-cu13, nvidia-nccl-cu13, ...). Those have to go,
# or torch ends up linking against the CUDA runtime on an Intel card. The
# pytorch-triton-xpu uninstall is deliberate too: the torch 2.15 resolve
# replaced it with the CUDA triton, and torch 2.8 needs the XPU build.
RUN set -eux; \
    pip list --format=freeze > /tmp/pkgs.txt; \
    grep -iE '^(nvidia-|cuda-|triton==|pytorch-triton-xpu$)' /tmp/pkgs.txt | cut -d= -f1 > /tmp/gone.txt || true; \
    if [ -s /tmp/gone.txt ]; then pip uninstall -y -r /tmp/gone.txt || true; fi; \
    rm -f /tmp/pkgs.txt /tmp/gone.txt; \
    pip install --no-cache-dir --index-url {{ arc_b70_e2a_index_url }} \
      "torch==2.8.0+xpu" "torchaudio==2.8.0+xpu" "pytorch-triton-xpu==3.4.0"; \
    python -c "import torch; v=torch.__version__; assert '+xpu' in v, v; assert torch.version.cuda is None, torch.version.cuda; print('FINAL-TORCH', v)"

# The dependency pins have teeth only if they are actually in effect. A
# resolved-but-unused transformers 5 would still break the engine, and a
# missing torchcodec would only surface at runtime. Assert the exact set.
RUN set -eux; \
    python -c "\
import importlib.metadata as md; \
from packaging.version import Version; \
assert Version(md.version('transformers')) < Version('5'), md.version('transformers'); \
assert Version(md.version('huggingface-hub')) < Version('1.0'), md.version('huggingface-hub'); \
assert md.version('pyannote-audio') == '3.4.0', md.version('pyannote-audio'); \
assert md.version('coqui-tts') == '0.27.5', md.version('coqui-tts'); \
import transformers.pytorch_utils as pu; \
assert hasattr(pu, 'isin_mps_friendly'), 'transformers no longer exports isin_mps_friendly'; \
print('PINS OK', md.version('transformers'), md.version('huggingface-hub'))"

# ---------------------------------------------------------------------------
# THE SOX BACKEND IS DEAD ON THIS IMAGE.
#
# torchaudio 2.8's sox backend SEGFAULTS inside the torch C++ dispatcher:
#
#   Fatal Python error: Segmentation fault
#     File "torch/_ops.py", line 1243 in __call__
#     File "torchaudio/_backend/sox.py", line 44 in load
#
# It is not an exception, so nothing reaches the log and the process just dies
# mid-conversion. The sox CLI reads the same file without complaint and
# soundfile reads it too, so this is the torchaudio C++ extension against
# Arch's sox-ng 14.8 -- not a bad file and not a missing library.
#
# coqui-tts' load_audio() calls torchaudio.load() on the reference waveform to
# clone a voice, so XTTS hits it on every book: the voice clone crashes the
# whole conversion, silently, after the UI has already started work.
#
# torchaudio.load picks a backend through a dispatcher that holds the backend
# map in a CLOSURE CELL captured at import time. Replacing the module attribute
# get_available_backends does nothing to it -- the cell has to be written
# directly, which is what sitecustomize.py does. Python imports sitecustomize
# automatically at interpreter start, so this applies to every process in the
# image, including the ones the app spawns.
#
# Removing sox leaves soundfile, which handles everything this app loads.
COPY sitecustomize.py /opt/venv/lib/python3.12/site-packages/sitecustomize.py

# Prove the patch is actually in effect and that loading a real WAV works.
# This is the check that would have caught the silent segfault.
RUN set -eux; \
    python -c "\
import torchaudio; \
d = torchaudio.load.__closure__[0].cell_contents; \
b = d.__closure__[0].cell_contents; \
assert 'sox' not in b, b; \
print('SOX BACKEND REMOVED', list(b))"

# Upstream's own directory layout -- the app reads and writes these paths.
RUN mkdir -p /app/ebooks /app/audiobooks /app/models /app/voices /app/tmp /app/run

VOLUME ["/app/ebooks", "/app/audiobooks", "/app/models", "/app/voices", "/app/tmp"]

EXPOSE 7860

# Upstream's own entrypoint, minus the Debian installer script: the image is
# already built, so app.py runs directly. --script_mode full_docker is what
# makes it read DOCKER_DEVICE_STR and serve on 7860.
ENTRYPOINT ["python", "-u", "app.py", "--script_mode", "full_docker"]
