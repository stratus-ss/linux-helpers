+def _load_audio_soundfile(reference_audio):
+    """Read a WAV through soundfile and return (waveform[1, N] float32, sr).
+
+    torchaudio.load cannot be used here: in torchaudio >= 2.9 every backend
+    goes through torchcodec, and torchcodec ships only a CUDA build.
+    """
+    import soundfile as sf
+
+    if isinstance(reference_audio, bytes):
+        reference_audio = io.BytesIO(reference_audio)
+
+    data, original_sr = sf.read(reference_audio, dtype="float32", always_2d=True)
+    # soundfile returns [frames, channels]; torchaudio.load returned
+    # [channels, frames].
+    waveform = torch.from_numpy(data.T)
+    return waveform, original_sr
+
