# ComfyUI on torch.xpu -- built from upstream source on the shared XPU base.
#
# This replaces the native venv install (the role's previous shape) with an
# immutable image. The native side was the fragile half of this host: three
# custom nodes whose CUDA-only requirements had to be filtered at install time,
# plus a hand-built XPU venv that the Ansible role had to reconstruct on every
# run. Here the filtering is a build step that runs once, and the image is the
# artifact that can be carried elsewhere.
#
# MODELS ARE NEVER BAKED. The 121 GB model set lives on the host filesystem
# and is bind-mounted read-only at /opt/comfyui/models.
FROM containers.x86experts.com:5000/arc-b70/xpu-base:2026.11

ARG COMFYUI_VERSION=v0.32.0
ARG STABLEAUDIO_COMMIT=1fa0c1155b1c7f42a3c73e48bddc0b55fef1dba0
ARG TTSSUITE_COMMIT=e70ea77eb89768cdf8b6031bc8cbfb6c5f805d6c
ARG CONTROLNET_COMMIT=e8b689a513c3e6b63edc44066560ca5919c0576e

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_BREAK_SYSTEM_PACKAGES=1

# The full clone, not --depth 1: a shallow tag clone leaves the repo in a
# detached HEAD with the fetch refspec rewritten to the tag
# (+refs/tags/v0.32.0:refs/tags/v0.32.0), and the git module cannot reconcile
# that on a re-run -- it fails with "'NoneType' object has no attribute
# 'startswith'". A full clone keeps a normal branch and refspec.
#
# The clone lands in /opt/comfyui itself because ComfyUI expects its own
# directory to be the app root (it writes output/ and models/ beside it).
RUN git clone --branch ${COMFYUI_VERSION} https://github.com/comfyanonymous/ComfyUI.git /opt/comfyui

# WORKDIR is set IMMEDIATELY after the clone. The runtime command is
# "python main.py" -- relative -- and a container's working directory defaults
# to "/", so without this the entrypoint cannot find main.py and the container
# dies at start-up with a file-not-found that looks nothing like a path bug.
WORKDIR /opt/comfyui

# The H3 probe workflow is baked into the image so the container carries it,
# and the role ALSO copies it into the host build context. The acceptance
# render (Task 8) posts the BUILD-CONTEXT copy
# (/opt/arc/comfyui/build/workflows/h3_probe_api.json) -- that path exists on
# the host; the in-image /opt/comfyui/... path does not. The native install's
# leftover workflows/ directory is not used.
COPY workflows/ /opt/comfyui/workflows/

# The XPU wheels go in FIRST, not last. requirements.txt lists torch,
# torchvision and torchaudio UNPINNED, so a plain resolve takes PyPI's CUDA
# build over the XPU one -- which is exactly the defect class this image
# exists to remove. Installing them first means the later requirement passes
# are already satisfied and the CUDA stack is never fetched at all.
#
# The index is --index-url, not --extra-index-url, because torch itself must
# come from the XPU index. Note that --index-url REPLACES PyPI (pip docs:
# "install from a different index, and not PyPI") -- it does not add to it.
# This step therefore resolves only because the XPU index also serves torch's
# pure-Python dependencies (filelock, sympy, networkx, ...): measured
# 2026-11-17, /whl/xpu/filelock/ and /whl/xpu/sympy/ both return 200. The next
# RUN restores PyPI as the base index via --extra-index-url for requirements.txt.
RUN pip install --no-cache-dir \
      --index-url https://download.pytorch.org/whl/xpu \
      torch=={{ arc_b70_xpu_torch_version }} torchvision torchaudio

# The constraint file names torch ONLY. torchvision versions on its own 0.x
# scheme, so pinning it to torch's version would name a version that does not
# exist.
#
# The constraint file names torch and pandas.
#
# torch: torchvision versions on its own 0.x scheme, so pinning it to torch's
# version would name a version that does not exist.
#
# pandas: this is what disarms the poisoned pin described below. stable-audio-
# tools pins pandas==2.0.2, which predates Python 3.12 and therefore has NO
# cp312 wheel -- pip falls back to the sdist, whose isolated build env dies with
# "ModuleNotFoundError: No module named 'pkg_resources'". Constraining pandas to
# a cp312-compatible release lets the closure resolve instead of being skipped.
#
# It is created here rather than assumed: without it the --constraint flag
# fails the build with "failed to read constraint file".
RUN printf 'torch=={{ arc_b70_xpu_torch_version }}\npandas>=2.2,<2.3\n' > /tmp/constraints.txt

# --no-deps on the requirements, then the dependency closures with
# --extra-index-url plus the same constraint.
#
# --extra-index-url, not --index-url: --index-url REPLACES PyPI, so the
# PyPI-only packages (pillow, scipy, kornia, av, blake3) would not resolve.
RUN pip install --no-cache-dir --no-deps -r /opt/comfyui/requirements.txt
RUN pip install --no-cache-dir \
      --extra-index-url https://download.pytorch.org/whl/xpu \
      --constraint /tmp/constraints.txt \
      -r /opt/comfyui/requirements.txt

# The three custom nodes, at pinned commits. Never HEAD: the image has to be
# reproducible, and a moving commit changes what the image contains without
# changing its tag.
#
# The full clones are for the same refspec reason as ComfyUI's own clone.
RUN git clone https://github.com/lks-ai/ComfyUI-StableAudioSampler \
        /opt/comfyui/custom_nodes/ComfyUI-StableAudioSampler \
 && git -C /opt/comfyui/custom_nodes/ComfyUI-StableAudioSampler checkout ${STABLEAUDIO_COMMIT}
RUN git clone https://github.com/diodiogod/TTS-Audio-Suite.git \
        /opt/comfyui/custom_nodes/TTS-Audio-Suite \
 && git -C /opt/comfyui/custom_nodes/TTS-Audio-Suite checkout ${TTSSUITE_COMMIT}
RUN git clone https://github.com/Fannovel16/comfyui_controlnet_aux.git \
        /opt/comfyui/custom_nodes/comfyui_controlnet_aux \
 && git -C /opt/comfyui/custom_nodes/comfyui_controlnet_aux checkout ${CONTROLNET_COMMIT}

# CUDA-only packages that cannot build on Intel XPU:
#
#   flash_attn      -- needs nvcc and CUDA kernels. ComfyUI-StableAudioSampler
#                      never imports it, and TTS-Audio-Suite imports it only
#                      inside engines/index_tts, whose node loader catches the
#                      ImportError and skips that one engine.
#   onnxruntime-gpu -- the CUDA build of onnxruntime. The CPU build is what
#                      the nodes actually import -- they all say "import
#                      onnxruntime", which resolves to the GPU build only if
#                      it is installed first.
#
# torch/torchaudio/torchvision are filtered out too: these requirement files
# name them unversioned, and --no-deps does NOT stop a directly listed package
# from being installed -- so an unqualified "torch" would be resolved from
# PyPI (the CUDA build) and silently replace the XPU wheel.
#
# They are filtered out of the requirements BEFORE the install, not skipped at
# runtime.
RUN set -eux; \
    for node in ComfyUI-StableAudioSampler TTS-Audio-Suite comfyui_controlnet_aux; do \
      req="/opt/comfyui/custom_nodes/$node/requirements.txt"; \
      out="/opt/comfyui/custom_nodes/$node/requirements-xpu.txt"; \
      [ -f "$req" ] || continue; \
      grep -viE '^\s*(flash[-_]attn|onnxruntime-gpu|torch|torchaudio|torchvision)\b' "$req" > "$out"; \
    done

# Dependencies are NOT skipped here -- with --no-deps this node never imports.
# Its requirements name aeiou and stable-audio-tools directly, and aeiou's own
# closure is 19 packages (accelerate, holoviews, wandb, webdataset, plotly,
# umap-learn, ...). --no-deps installed aeiou without any of them, so the node
# failed one missing module per rebuild: first librosa, then opentelemetry, then
# whatever was next. That is not a bug to patch one module at a time.
#
# Two separate pins block a plain `pip install -r`:
#
#   stable-audio-tools -> pandas==2.0.2, which predates Python 3.12 and has no
#   cp312 wheel, so resolving it compiles the sdist and dies on pkg_resources.
#   Disarmed by the pandas constraint in /tmp/constraints.txt.
#
#   stable-audio-tools -> flash-attn>=2.5.0, declared UNCONDITIONALLY in its
#   metadata, so the grep filter above cannot see it (that only rewrites the
#   requirement files). flash-attn has no wheel at all: pip downloads the 8.5 MB
#   sdist and dies in its build backend, because building it needs nvcc.
#   Disarmed by installing stable-audio-tools itself with --no-deps and then
#   installing its own Requires-Dist list with flash-attn removed. The node does
#   not import flash_attn; only stable-audio-tools' training paths do.
#
# aeiou and the two loose requirements resolve normally, with deps.
RUN pip install --no-cache-dir \
      --extra-index-url https://download.pytorch.org/whl/xpu \
      --constraint /tmp/constraints.txt \
      aeiou einops numpy
RUN pip install --no-cache-dir --no-deps --constraint /tmp/constraints.txt stable-audio-tools

# stable-audio-tools' declared dependencies, minus the CUDA-only ones, minus
# the torch family (already correct, and reinstalling it would replace the XPU
# wheel), minus pandas, and with every EXACT pin removed.
#
# Two things are being worked around here, and both are the same root cause --
# this package's metadata predates Python 3.12 by a wide margin:
#
#   pandas         pinned EXACTLY (pandas==2.0.2), and a pip constraint cannot
#                  override an exact requirement -- pip reports
#                  ResolutionImpossible rather than picking 2.2. So the pin is
#                  not passed at all; pandas arrives from aeiou's closure above,
#                  where the >=2.2,<2.3 constraint in /tmp/constraints.txt
#                  applies.
#
#   PyWavelets     pinned EXACTLY too (==1.4.1), which also has no cp312 wheel,
#                  so pip builds the sdist and dies in its C build. Same story
#                  for whichever pin is next: the versions in this metadata were
#                  written before these packages shipped 3.12 wheels.
#
# So exact pins are stripped from the whole extracted list (>=, <, ~= are kept
# -- they express real compatibility ranges), and pip resolves wheel-available
# versions. Markers are stripped because they are not valid pip arguments.
#
# Read from the installed metadata rather than hardcoded, so a bump of
# stable-audio-tools cannot silently leave a dependency out.
RUN set -eux; \
    deps="$(python -c 'import importlib.metadata as m, re; skip={"flash-attn","flash_attn","torch","torchaudio","torchvision","triton","pandas"}; s=[x.split(";")[0].strip() for x in (m.requires("stable-audio-tools") or [])]; s=[re.sub(r"==[0-9][^,]*", "", x).strip() for x in s]; s=[x for x in s if x and re.split(r"[<>=!~\[ ]", x, maxsplit=1)[0].lower().replace("_","-") not in skip]; print(" ".join(s))')"; \
    pip install --no-cache-dir \
      --extra-index-url https://download.pytorch.org/whl/xpu \
      --constraint /tmp/constraints.txt \
      $deps

# comfyui_controlnet_aux is with-deps for the same class of reason: --no-deps
# left out pyparsing (via matplotlib) and the node failed at IMPORT, which kills
# ComfyUI at start-up rather than at render time.
RUN pip install --no-cache-dir \
      --constraint /tmp/constraints.txt \
      -r /opt/comfyui/custom_nodes/comfyui_controlnet_aux/requirements-xpu.txt
RUN pip install --no-cache-dir \
      --extra-index-url https://download.pytorch.org/whl/xpu \
      --constraint /tmp/constraints.txt \
      -r /opt/comfyui/custom_nodes/TTS-Audio-Suite/requirements-xpu.txt

# onnxruntime-gpu was filtered out above, so the CPU build is what lands. The
# nodes import "onnxruntime" and need the real package.
RUN pip install --no-cache-dir --no-deps onnxruntime

# openai-whisper (a TTS-Audio-Suite requirement) declares triton>=2, and that is
# the CUDA-only package. It cannot be filtered out at the requirements level the
# way flash-attn can, because it is TRANSITIVE -- the grep filter only rewrites
# the direct requirement files.
#
# Uninstalling it is NOT enough on its own, and the first attempt at this proved
# it: triton-xpu and triton both install a package directory called `triton`, so
# removing the CUDA distribution deletes files the XPU one needs, and torch dies
# at import with
#   AttributeError: module 'triton' has no attribute 'language'
# (torch._dynamo/utils.py does `import triton` and reads triton.language.dtype).
# So triton-xpu is force-reinstalled immediately afterwards, at whatever version
# is already installed -- repinning it here would drift against torch's own pin.
# It must come from the PyTorch XPU index: triton-xpu is not published on PyPI,
# and asking PyPI for it fails with "No matching distribution found".
#
# The final assertion below then sees triton-xpu (which does not match its
# `^(nvidia-|cuda-|triton==)` pattern) and no bare triton.
RUN pip uninstall -y triton; \
    pip install --no-cache-dir --force-reinstall --no-deps \
      --index-url https://download.pytorch.org/whl/xpu \
      "triton-xpu==$(python -c 'import importlib.metadata as m; print(m.version("triton-xpu"))')"

# The assertion that makes a silently CPU-only image impossible. It reads the
# image's OWN torch: "+xpu" in the version proves the XPU wheel is the one
# installed, and torch.version.cuda is None proves nothing displaced it.
#
# The second line is not redundant: importing torch is not the same as importing
# torch._dynamo, and that is where a broken triton shows up. A build once shipped
# with `triton` uninstalled but triton-xpu's files removed alongside it, and the
# version check passed while the container died at start-up with
# "module 'triton' has no attribute 'language'". The import check catches that
# at build time instead.
#
# It does NOT prove the device is usable: a build has no device pass-through,
# so torch.xpu.is_available() inside a build layer is False by construction.
# The device assertion is a RUN-TIME one, in the deployed container, with
# /dev/dri passed through (Task 8).
RUN set -eux; \
    python -c "import torch; v=torch.__version__; assert '+xpu' in v, v; assert torch.version.cuda is None, torch.version.cuda; print('FINAL-TORCH', v)"; \
    python -c "import torch._dynamo, triton; print('TORCH-IMPORTS-OK', triton.__version__)"; \
    pip list --format=freeze | grep -iE '^(nvidia-|cuda-|triton==)' && { echo 'CUDA-PACKAGES-PRESENT'; exit 1; } || echo 'NO-CUDA-PACKAGES'

# The non-root runtime user. UID 10001 is shared with the FishTTS image so
# one UID owns both services' writable paths.
# ComfyUI creates its TEMP directory at start-up (main.py does
# os.makedirs(folder_paths.get_temp_directory(), exist_ok=True)) and dies with
# "PermissionError: [Errno 13] Permission denied: '/opt/comfyui/temp'" if it
# cannot. It is not in the compose mounts -- it is image-local scratch -- so it
# has to be created here, owned by the runtime user.
RUN useradd -u 10001 -m -s /usr/bin/nologin comfy \
 && mkdir -p /opt/comfyui/output /opt/comfyui/input /opt/comfyui/user /opt/comfyui/temp \
 && chown -R 10001:10001 /opt/comfyui/output /opt/comfyui/input /opt/comfyui/user /opt/comfyui/temp /opt/comfyui/custom_nodes

# custom_nodes is chowned as well, and it is load-bearing: the git clones above
# land root-rooted. TTS-Audio-Suite creates its own .cache directory at import
# and died with
#   PermissionError: [Errno 13] Permission denied:
#     '/opt/comfyui/custom_nodes/TTS-Audio-Suite/.cache'
# which does NOT fail the container -- ComfyUI logs "Cannot import ... module
# for custom nodes" and starts without that node's types. Measured 2026-11-18.

# Models are a MOUNT POINT. The directory exists so the bind mount has
# somewhere to land; it is never populated in the image.
RUN mkdir -p /opt/comfyui/models

USER 10001:10001

EXPOSE 8188

# No ENTRYPOINT and no CMD: the compose file supplies the command, so the
# container's argv is the compose "command" verbatim. The image does not
# second-guess it.
